#!/bin/sh
# Flip the USB-C port between gadget and host, and drive VBUS for host mode.
#
#   usb-role            show the current role
#   usb-role host       become a USB host and power the port (keyboard, SSD, hub)
#   usb-role device     go back to the RNDIS/ACM gadget (SSH over USB)
#
# The port is dual-role in the device tree but nothing on this board tells the
# kernel which way it should be - there is no Type-C controller driver and no ID
# pin mainline knows about - so it is a manual choice. It resets to device on
# every boot, deliberately, so the gadget lifeline is always there after a
# reboot even if Wi-Fi is broken.
#
# VBUS comes from the SM5705 charger, which has no driver yet, so the boost is
# poked directly over I2C here. Register map from Silicon Mitus/Samsung sources
# and cross-checked against the live part: CNTL read back 0x05 = CHG_ON and
# FLEDCNTL6 read 0x05 = 4500 mV, both exactly what the vendor operation-mode
# table says they should be at rest.
#
#   0x0c CNTL       bits 2:0   operation mode: 5 = CHG_ON, 7 = USB_OTG
#   0x14 CHGCNTL6   bits 3:2   OTG current limit: 2 = 900 mA
#   0x20 FLEDCNTL6  bits 3:0   boost output: 5 = 4500 mV, 0xb = 5100 mV
#
# Doing this from a shell script is a stopgap. The right home for it is a
# charger driver exposing a VBUS regulator that the role switch drives.

set -eu

CHG_BUS=1
CHG_ADDR=0x49
REG_CNTL=0x0c
REG_CHGCNTL6=0x14
REG_FLEDCNTL6=0x20

OP_MODE_CHG_ON=5
OP_MODE_USB_OTG=7
BST_OUT_5100MV=0x0b
BST_OUT_4500MV=0x05
OTG_CURRENT_900MA=2

FUELGAUGE=/sys/class/power_supply/sm5705-fuelgauge

rmw() { # register, mask, value
	old=$(i2cget -y $CHG_BUS $CHG_ADDR "$1" b)
	new=$(( (old & ~$2) | $3 ))
	i2cset -y $CHG_BUS $CHG_ADDR "$1" $new b
}

vbus_on() {
	# Refuse to source VBUS while something is charging us. Sourcing and
	# sinking at the same time is not a state to go looking for.
	if [ -r "$FUELGAUGE/status" ] && [ "$(cat $FUELGAUGE/status)" = "Charging" ]; then
		echo "usb-role: a charger is attached, not enabling VBUS" >&2
		return 1
	fi
	rmw $REG_FLEDCNTL6 0x0f $BST_OUT_5100MV
	rmw $REG_CHGCNTL6  0x0c $(( OTG_CURRENT_900MA << 2 ))
	rmw $REG_CNTL      0x07 $OP_MODE_USB_OTG
}

vbus_off() {
	rmw $REG_CNTL      0x07 $OP_MODE_CHG_ON
	rmw $REG_FLEDCNTL6 0x0f $BST_OUT_4500MV
}

ROLE_FILE=$(ls /sys/class/usb_role/*/role 2>/dev/null | head -1)

if [ -z "$ROLE_FILE" ]; then
	echo "usb-role: no USB role switch found." >&2
	echo "  Needs dr_mode = \"otg\" + usb-role-switch in the DT, and a kernel" >&2
	echo "  where dwc3 sets allow_userspace_control (see kernel/patches)." >&2
	exit 1
fi

case "${1:-}" in
"")
	printf '%s' "$(cat "$ROLE_FILE")"
	mode=$(( $(i2cget -y $CHG_BUS $CHG_ADDR $REG_CNTL b) & 7 ))
	[ "$mode" = "$OP_MODE_USB_OTG" ] && printf ' (VBUS on)'
	echo
	;;
host)
	vbus_on || exit 1
	echo host > "$ROLE_FILE"
	sleep 3
	echo "usb role: $(cat "$ROLE_FILE") (VBUS on)"
	# Real devices look like "1-1"; "1-0:1.0" and "usb1" are the root hubs
	# themselves and are always present, so do not count them.
	n=$(ls /sys/bus/usb/devices/ 2>/dev/null | grep -cE '^[0-9]+-[0-9]+$' || true)
	echo "devices attached: $n"
	;;
device | none)
	echo "$1" > "$ROLE_FILE"
	vbus_off
	# The switch takes a moment; reading straight back reports the old role.
	sleep 2
	echo "usb role: $(cat "$ROLE_FILE") (VBUS off)"
	;;
*)
	echo "usage: usb-role [host|device|none]" >&2
	exit 1
	;;
esac
