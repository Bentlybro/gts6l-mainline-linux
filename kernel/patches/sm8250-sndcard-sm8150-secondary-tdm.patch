+static int sm8250_tdm_hw_params(struct snd_soc_pcm_runtime *rtd,
+				struct snd_pcm_hw_params *params,
+				int stream)
+{
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	unsigned int channels = params_channels(params);
+	unsigned int bclk, mask;
+	struct snd_soc_dai *cdai;
+	int ret, j;
+
+	if (!channels || channels > TDM_SLOTS)
+		return -EINVAL;
+
+	/* The fixup above pins this, so a mismatch here means it did not run. */
+	if (params_width(params) != TDM_SLOT_WIDTH)
+		return -EINVAL;
+
+	mask = GENMASK(channels - 1, 0);
+	bclk = TDM_SLOTS * TDM_SLOT_WIDTH * params_rate(params);
+
+	ret = snd_soc_dai_set_sysclk(cpu_dai, Q6AFE_LPASS_CLK_ID_SEC_TDM_IBIT,
+				     bclk, SNDRV_PCM_STREAM_PLAYBACK);
+	if (ret)
+		return ret;
+
+	/*
+	 * The DSP needs both halves of this: the slot geometry, and a slot
+	 * mapping for every channel. Without the mapping,
+	 * afe_param_id_slot_mapping_cfg goes out all zeroes and
+	 * AFE_PORT_CMD_SET_PARAM_V2 (0x100ef) comes straight back as
+	 * "DSP returned error[2]", which says nothing about which half is wrong.
+	 */
+	if (stream == SNDRV_PCM_STREAM_PLAYBACK) {
+		ret = snd_soc_dai_set_tdm_slot(cpu_dai, 0, mask,
+					       TDM_SLOTS, TDM_SLOT_WIDTH);
+		if (ret)
+			return ret;
+
+		ret = snd_soc_dai_set_channel_map(cpu_dai, 0, NULL,
+						  channels, tdm_slot_offset);
+	} else {
+		ret = snd_soc_dai_set_tdm_slot(cpu_dai, mask, 0,
+					       TDM_SLOTS, TDM_SLOT_WIDTH);
+		if (ret)
+			return ret;
+
+		ret = snd_soc_dai_set_channel_map(cpu_dai, channels,
+						  tdm_slot_offset, 0, NULL);
+	}
+	if (ret)
+		return ret;
+
+	/*
+	 * One amp per slot, in the order the codecs are listed in the dai-link.
+	 * cs35l41 has no set_tdm_slot op, so its slot is chosen through
+	 * set_channel_map, and it wants a slot index rather than a byte offset.
+	 */
+	for_each_rtd_codec_dais(rtd, j, cdai) {
+		unsigned int slot = j;
+
+		/*
+		 * cs35l41 has TWO clock entry points and needs both. The
+		 * component one points its PLL at the ASP bit clock (clk id 0
+		 * is CS35L41_CLKID_SCLK), the DAI one sets the clock monitor
+		 * window. Miss them and the amp never finishes powering up:
+		 * cs35l41_global_enable() polls for PUP_DONE and gives up with
+		 * "Enable(1) failed: -110", which reads like a dead amp rather
+		 * than an unconfigured clock.
+		 */
+		ret = snd_soc_component_set_sysclk(cdai->component, 0, 0,
+						   bclk, SND_SOC_CLOCK_IN);
+		if (ret && ret != -ENOTSUPP)
+			return ret;
+
+		ret = snd_soc_dai_set_sysclk(cdai, 0, bclk, SND_SOC_CLOCK_IN);
+		if (ret && ret != -ENOTSUPP)
+			return ret;
+
+		ret = snd_soc_dai_set_channel_map(cdai, 1, &slot, 1, &slot);
+		if (ret && ret != -ENOTSUPP)
+			return ret;
+	}
+
+	return 0;
+}
+
 static int sm8250_snd_hw_params(struct snd_pcm_substream *substream,
 				struct snd_pcm_hw_params *params)
 {
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
 	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
 	struct sm8250_snd_data *pdata = snd_soc_card_get_drvdata(rtd->card);
+	int ret;
+
+	switch (cpu_dai->id) {
+	case SECONDARY_TDM_RX_0:
+	case SECONDARY_TDM_TX_0:
+		ret = sm8250_tdm_hw_params(rtd, params, substream->stream);
+		if (ret)
+			return ret;
+		break;
+	default:
+		break;
+	}
 
 	return qcom_snd_sdw_hw_params(substream, params, &pdata->sruntime[cpu_dai->id]);
 }
