 #define DRIVER_NAME		"sm8250"
 #define MI2S_BCLK_RATE		1536000
 
+/* Secondary TDM on the Galaxy Tab S6: four CS35L41 amps share one bus. */
+#define TDM_SLOTS		4
+
+/*
+ * 16 bit slots, NOT the 32 that Samsung's own overlay programs.
+ *
+ * cs35l41_pcm_hw_params() writes params_width() into BOTH the ASP slot width
+ * and the ASP word length, so the sample width and the TDM slot width have to
+ * be the same number. Give the DSP 32 bit slots while the amp believes they are
+ * 16, and each amp reads the wrong bit positions of the frame: some speakers
+ * get the right data, the rest get padding and neighbouring samples, and it
+ * comes out as loud crunching noise rather than as silence.
+ *
+ * cs35l41 supports only S16_LE and S24_LE, and q6afe accepts only 16 or 32 bit
+ * slots, so 16 everywhere is the single self consistent choice. The bit clock
+ * follows from it: 4 x 16 x 48 kHz = 3.072 MHz, half of Samsung's 6.144 MHz.
+ */
+#define TDM_SLOT_WIDTH		16
+
+/*
+ * Byte offsets of each slot within the frame, so slot n starts at byte
+ * n * TDM_SLOT_WIDTH / 8. q6afe wants these OFFSETS, while cs35l41's
+ * SP_FRAME_RX_SLOT wants the slot INDEX: two different units for the same
+ * thing, and only the DSP complains when they are mixed up.
+ */
+static unsigned int tdm_slot_offset[TDM_SLOTS] = { 0, 2, 4, 6 };
+
 struct sm8250_snd_data {
 	bool stream_prepared[AFE_PORT_MAX];
 	struct snd_soc_card *card;
