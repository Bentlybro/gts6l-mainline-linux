 #define DRIVER_NAME		"sm8250"
 #define MI2S_BCLK_RATE		1536000
 
+/* Secondary TDM on the Galaxy Tab S6: four CS35L41 amps share one bus. */
+#define TDM_SLOTS		4
+
+/*
+ * 32 bit slots, which with 4 slots at 48 kHz is the 6.144 MHz Samsung's own
+ * overlay programs (qcom,msm-cpudai-tdm-clk-rate = <0x5dc000>).
+ *
+ * The subtlety is that the DSP and the amps do not agree on what a slot is.
+ * cs35l41_pcm_hw_params() writes params_width() into the amp's ASP slot width,
+ * and the amp supports only S16_LE and S24_LE, so with 16 bit samples each amp
+ * counts the frame in 16 bit slots while the DSP lays it out in 32 bit ones.
+ * Amp N's data therefore starts at amp-slot N * (32 / 16), not at slot N.
+ *
+ * Getting that wrong is not silence, it is noise: with slots 0,1,2,3 the first
+ * amp gets real audio, the second gets the padding half of the first channel,
+ * the third gets the second channel, and it plays out of every speaker while
+ * sounding like loud crunching.
+ */
+#define TDM_SLOT_WIDTH		32
+
+/*
+ * Which slot each channel goes in, as BYTE offsets into the frame: slot n
+ * starts at byte n * TDM_SLOT_WIDTH / 8.
+ *
+ * These are not slot indices, and the DSP is emphatic about it. Feeding it
+ * { 0, 1, 2, 3 } puts channel 1 one byte into slot 0 rather than at the start
+ * of slot 1, and AFE_PORT_CMD_SET_PARAM_V2 (0x100ef) comes back "DSP returned
+ * error[2]" with no audio at all. Same array shape as the downstream machine
+ * drivers, and for the same reason.
+ */
+static unsigned int tdm_slot_offset[TDM_SLOTS] = { 0, 4, 8, 12 };
+
 struct sm8250_snd_data {
 	bool stream_prepared[AFE_PORT_MAX];
 	struct snd_soc_card *card;
